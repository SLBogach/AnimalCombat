{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/combat/rejection/0.1/combat-rejection.schema.json",
  "title": "Battle Rejection Record Schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "combat.rejection/0.1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "battle_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "engine_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "config_hash": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rejected_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"
          },
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "entity_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "message_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "details": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "code",
          "path",
          "entity_id",
          "message_key",
          "details"
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{1,63}/[A-Za-z0-9_.-]{1,64}$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "battle_id",
    "engine_version",
    "config_hash",
    "rejected_at_utc",
    "errors",
    "extensions"
  ]
}
