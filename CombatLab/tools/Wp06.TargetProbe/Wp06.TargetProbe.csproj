<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wp06.TargetProbe</RootNamespace>
    <AssemblyName>Wp06.TargetProbe</AssemblyName>
    <CombatTarget Condition="'$(CombatTarget)' == ''">net10.0</CombatTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Battle.Config">
      <HintPath>..\..\src\Battle.Config\bin\$(Configuration)\$(CombatTarget)\Battle.Config.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Battle.Contracts">
      <HintPath>..\..\src\Battle.Contracts\bin\$(Configuration)\$(CombatTarget)\Battle.Contracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Battle.Core">
      <HintPath>..\..\src\Battle.Core\bin\$(Configuration)\$(CombatTarget)\Battle.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Battle.Replay">
      <HintPath>..\..\src\Battle.Replay\bin\$(Configuration)\$(CombatTarget)\Battle.Replay.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateCombatTarget" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(CombatTarget)' != 'netstandard2.1' and '$(CombatTarget)' != 'net10.0'"
      Text="CombatTarget must be netstandard2.1 or net10.0." />
  </Target>
</Project>
